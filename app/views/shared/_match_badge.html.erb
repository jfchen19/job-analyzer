<%#
  Renders a match_level badge. Usage:
    render "shared/match_badge", level: analysis.match_level
    render "shared/match_badge", level: "high", size: :lg
  (NOTE: keep the ERB output delimiters OUT of this comment — a stray
   closing tag ends the comment early and turns the example into real code,
   which self-renders this partial and blows the stack.)
%>
<% level = local_assigns[:level].to_s
   size  = local_assigns.fetch(:size, :sm)
   styles = {
     "high"   => %w[bg-green-100 text-green-800 border-green-300],
     "medium" => %w[bg-yellow-100 text-yellow-800 border-yellow-300],
     "low"    => %w[bg-red-100 text-red-800 border-red-300]
   }
   labels = { "high" => "高度符合 · HIGH", "medium" => "中度符合 · MEDIUM", "low" => "低度符合 · LOW" }
   klass = styles.fetch(level, %w[bg-gray-100 text-gray-600 border-gray-300])
   dims  = size == :lg ? "px-4 py-2 text-base" : "px-2.5 py-0.5 text-xs" %>
<span class="inline-flex items-center rounded-full border font-semibold <%= klass.join(' ') %> <%= dims %>">
  <%= labels.fetch(level, level.presence || "—") %>
</span>
