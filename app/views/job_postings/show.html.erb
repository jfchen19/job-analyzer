<% content_for :title, @job_posting.job_title %>

<div class="flex items-start justify-between mb-6 gap-4">
  <div class="min-w-0">
    <h1 class="text-2xl font-bold truncate"><%= @job_posting.job_title %></h1>
    <p class="text-gray-500 mt-1"><%= @job_posting.company_name.presence || "（未填公司名稱）" %></p>
    <% if @job_posting.source_url.present? %>
      <%= link_to "查看原始職缺 ↗", @job_posting.source_url, target: "_blank", rel: "noopener",
            class: "text-sm text-indigo-600 hover:underline" %>
    <% end %>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <% if @job_posting.status == "pending" %>
      <%= button_to "開始分析", analyze_job_posting_path(@job_posting), method: :post,
            class: "px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700" %>
    <% else %>
      <%= button_to "重新分析", analyze_job_posting_path(@job_posting), method: :post,
            class: "px-4 py-2 rounded-md border border-gray-300 text-sm hover:bg-gray-50" %>
    <% end %>
    <%= link_to "返回列表", job_postings_path, class: "px-4 py-2 rounded-md border border-gray-300 text-sm hover:bg-gray-50" %>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-6">
  <%# --- JD original text --- %>
  <div class="bg-white border border-gray-200 rounded-lg p-5">
    <h2 class="font-semibold mb-3">職缺描述 (JD)</h2>
    <div class="text-sm text-gray-700 whitespace-pre-line max-h-[32rem] overflow-y-auto"><%= @job_posting.raw_content %></div>
  </div>

  <%# --- Analysis result --- %>
  <div class="space-y-4">
    <% if @analysis %>
      <div class="bg-white border border-gray-200 rounded-lg p-5 text-center">
        <p class="text-sm text-gray-500 mb-2">匹配度</p>
        <%= render "shared/match_badge", level: @analysis.match_level, size: :lg %>
      </div>

      <%# key requirements %>
      <div class="bg-white border border-gray-200 rounded-lg p-5">
        <h3 class="font-semibold mb-3">職缺核心要求</h3>
        <% reqs = @analysis.parsed_key_requirements %>
        <% if reqs.any? %>
          <div class="flex flex-wrap gap-2">
            <% reqs.each do |r| %>
              <span class="inline-flex items-center rounded-md bg-gray-100 text-gray-700 px-2.5 py-1 text-sm"><%= r %></span>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400">（無)</p>
        <% end %>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <%# matched skills (green) %>
        <div class="bg-green-50 border border-green-200 rounded-lg p-5">
          <h3 class="font-semibold text-green-800 mb-3">符合的技能</h3>
          <% matched = @analysis.parsed_matched_skills %>
          <% if matched.any? %>
            <ul class="space-y-1.5">
              <% matched.each do |s| %>
                <li class="text-sm text-green-900 flex gap-2"><span>✓</span><span><%= s %></span></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-green-700/60">（無)</p>
          <% end %>
        </div>

        <%# skill gaps (red) %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-5">
          <h3 class="font-semibold text-red-800 mb-3">技能缺口</h3>
          <% gaps = @analysis.parsed_skill_gaps %>
          <% if gaps.any? %>
            <ul class="space-y-1.5">
              <% gaps.each do |s| %>
                <li class="text-sm text-red-900 flex gap-2"><span>✗</span><span><%= s %></span></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-red-700/60">（無)</p>
          <% end %>
        </div>
      </div>

      <%# cover letter suggestion + copy %>
      <div class="bg-white border border-gray-200 rounded-lg p-5" data-controller="clipboard">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-semibold">自我介紹建議</h3>
          <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
                  class="px-2.5 py-1 rounded border border-gray-300 text-xs hover:bg-gray-50">複製</button>
        </div>
        <p data-clipboard-target="source" class="text-sm text-gray-700 whitespace-pre-line leading-relaxed"><%= @analysis.cover_letter_suggestion %></p>
      </div>

      <p class="text-xs text-gray-400 text-right">分析於 <%= @analysis.created_at.strftime("%Y-%m-%d %H:%M") %></p>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg px-5 py-12 text-center text-gray-400 text-sm">
        尚未分析。點右上角「開始分析」讓 AI 對照你的預設履歷產生匹配報告。
      </div>
    <% end %>
  </div>
</div>
